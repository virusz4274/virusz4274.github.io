---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredProjects = (
  await getCollection("projects", ({ data }) => !data.draft && data.featured)
).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
        I’m Harisankar.
      </h1>
      <p class="text-xl leading-relaxed sm:text-2xl">
        I build products and the systems that keep them running.
      </p>
      <p class="mt-4 leading-relaxed">
        My work spans creator payments, AI tools, PC businesses, and business
        operations. I turn practical problems into software, workflows, and
        services.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        <LinkButton
          class="text-accent underline decoration-dashed underline-offset-4"
          href="/projects/"
          >Explore my work <IconArrowRight aria-hidden="true" /></LinkButton
        >
        <LinkButton
          class="text-accent underline decoration-dashed underline-offset-4"
          href="mailto:harisankar@coarde.com">Get in touch</LinkButton
        >
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section
          id="selected-projects"
          class="border-border border-b pt-10 pb-6"
          aria-labelledby="projects-heading"
        >
          <h2 id="projects-heading" class="text-2xl font-semibold">
            Selected projects
          </h2>
          <ul>
            {featuredProjects.map(project => (
              <ProjectCard {project} />
            ))}
          </ul>
          <LinkButton
            href="/projects/"
            class="text-accent my-4 underline decoration-dashed underline-offset-4"
          >
            All projects <IconArrowRight aria-hidden="true" />
          </LinkButton>
        </section>
      )
    }
    <section id="writing" class="py-10" aria-labelledby="writing-heading">
      <div class="flex items-center gap-3">
        <h2 id="writing-heading" class="text-2xl font-semibold">Writing</h2>
        <a href="/rss.xml" class="text-accent" aria-label="RSS feed"
          ><IconRss width={20} height={20} /></a
        >
      </div>
      <p class="mt-3">
        Notes from building, running businesses, and following my curiosity.
      </p>
      <ul>
        {
          sortedPosts
            .slice(0, postsConfig.perIndex)
            .map(data => <Card variant="h3" {...data} />)
        }
      </ul>
      <div class="mt-6 flex flex-wrap gap-6">
        <LinkButton
          href="/posts/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >All writing <IconArrowRight aria-hidden="true" /></LinkButton
        >
        <LinkButton
          href="/tags/"
          class="text-accent underline decoration-dashed underline-offset-4"
          >Browse topics</LinkButton
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
